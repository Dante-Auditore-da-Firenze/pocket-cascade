{
  "name": "pocket-cascade",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0" },
  "description": "A little machine. An extraordinary chain reaction.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Pocket Cascade",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:balance": "tsx scripts/balance.ts",
    "test:desktop": "playwright test --config playwright.electron.config.ts",
    "test:package": "node scripts/verify-package.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:steam": "tsx scripts/store-assets.ts",
    "notices:generate": "node scripts/generate-notices.mjs",
    "desktop": "electron .",
    "package:win": "node scripts/prepare-desktop.mjs && npm run assets:generate && npm run notices:generate && npm run build && electron-builder --win portable --x64",
    "package:dir": "node scripts/prepare-desktop.mjs && npm run assets:generate && npm run notices:generate && npm run build && electron-builder --dir --win --x64",
    "verify": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  }
}
